        (.then (fn [xs] (check! "attachment JS field coercion" ["Attachment f (image,png, [object Object] bytes)" "web:url:https://example.invalid/a,b"] [(.. (aget xs 0) -extra -preview) (.-target_node_id (aget xs 1))])))
