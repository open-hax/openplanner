        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "collision-one" :ts "2026-01-01T00:41:00Z" :source "synthetic" :kind "graph.edge" :extra {:source_node_id "a||b" :target_node_id "c" :edge_kind "edge" :first "one"}}
                              {:schema "openplanner.event.v1" :id "collision-middle" :ts "2026-01-01T00:41:30Z" :source "synthetic" :kind "graph.edge" :extra {:source_node_id "middle" :target_node_id "key" :edge_kind "edge"}}
                              {:schema "openplanner.event.v1" :id "collision-two" :ts "2026-01-01T00:42:00Z" :source "synthetic" :kind "graph.edge" :extra {:source_node_id "a" :target_node_id "b||c" :edge_kind "edge" :second "two"}}])))
        (.then (fn [r] (println "EDGE-COLLISION" (pr-str r)) (check! "reference concatenated-key collision response" [200 3] [(:status r) (get-in r [:body :projectedGraphEdges])])
                 (js/Promise.all #js [(.countDocuments edges #js {:_id "a||b||c||edge"}) (.findOne edges #js {:_id "a||b||c||edge"}) (-> (.find edges #js {:_id #js {:$in #js ["a||b||c||edge" "middle||key||edge"]}}) (.sort #js {:$natural 1}) (.toArray))])))
        (.then (fn [xs] (let [doc (aget xs 1)] (check! "reference collision retains last row and merges data" [1 "a" "b||c" "one" "two"] [(aget xs 0) (.-source_node_id doc) (.-target_node_id doc) (.. doc -data -first) (.. doc -data -second)])
                          (check! "collision first-key order retained around distinct key" ["a||b||c||edge" "middle||key||edge"] (mapv #(.-_id %) (vec (aget xs 2)))))))
