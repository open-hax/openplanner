;; Test-composed /v1 registration over loopback HTTP; disposable MongoDB only.
;; Run from repo root: OPENPLANNER_E2E_MONGO_URI=mongodb://127.0.0.1:PORT NODE_OPTIONS='--import tsx' nbb -cp src/cljs:tests tests/event5/slice_http.cljs
(ns slice-http (:require [event-slice :as slice] [lossless-json :as lj]))

(def uri (.-OPENPLANNER_E2E_MONGO_URI js/process.env))
(def db-name (str "openplanner5_app_" (.replaceAll (str (random-uuid)) "-" "")))
(def failures (atom 0))
(def background-tasks (atom []))
(def wrapped-calls (atom []))
(def model-scopes (atom []))
(def model-generation-order (atom []))
(def slow-reject (atom nil))
(defn wait-slow [remaining]
  (if (or @slow-reject (zero? remaining)) (js/Promise.resolve (some? @slow-reject))
      (-> (js/Promise. #(js/setTimeout %1 20)) (.then #(wait-slow (dec remaining))))))
(defn synthetic-embedding [texts]
  (if (some #(= "Topic: Slow" %) (vec texts))
    (js/Promise. (fn [_ reject] (reset! slow-reject reject)))
    (js/Promise.resolve (clj->js (mapv (fn [_] [0.25 0.75]) (vec texts))))))
(def embedding-calls (atom []))
(defn wait-embeddings [collection n]
  (letfn [(poll [remaining] (-> (.countDocuments collection #js {})
                                (.then (fn [count] (if (or (>= count n) (zero? remaining)) count
                                                     (-> (js/Promise. #(js/setTimeout %1 20)) (.then #(poll (dec remaining)))))))))]
    (poll 100)))
(defn check! [label expected actual]
  (if (= expected actual) (println "PASS" label)
      (do (swap! failures inc) (println "FAIL" label "expected" (pr-str expected) "got" (pr-str actual)))))
(defn request [base body auth? path]
  (-> (js/fetch (str base path) (clj->js {:method "POST" :headers (cond-> {"content-type" "application/json"} auth? (assoc "authorization" "Bearer isolated-test-key")) :body (js/JSON.stringify (lj/encode body))}))
      (.then (fn [response] (-> (.json response) (.then (fn [body] {:status (.-status response) :body (js->clj body :keywordize-keys true)})))))))

(defn event [id ts extra text]
  (cond-> {:schema "openplanner.event.v1" :id id :ts ts :source "discord" :kind "discord.message" :extra extra}
    (some? text) (assoc :text text)))
(defn run-cases [base db]
  (let [post #(request base {:events %} true "/v1/events")
        c (.collection db "events") edges (.collection db "graph_edges")
        ev (event "discord:g:c:m" "2026-01-01T00:01:00Z" {:guild_id "g" :channel_id "c" :previous_message_id "old" :topics ["Orbit"] :attachments [{:id "a" :filename "a.png"}]} nil)]
    (-> (request base {} false "/v1/events")
        (.then (fn [r] (check! "auth preserved" 401 (:status r)) (request base {} true "/v1/events")))
        (.then (fn [r] (check! "body validation" [400 "expected { events: [...] }"] [(:status r) (get-in r [:body :error])]) (post [(event "discord:g:c:noop" "2026-01-01T00:00:00Z" {} nil)])))
        (.then (fn [r] (check! "no-op response matches reference counters" [200 1 0 0 0 "skipped"] [(:status r) (get-in r [:body :count]) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])]) (post [ev])))
        (.then (fn [r] (check! "candidate projection and actual queue counts" [200 6 4 "queued"] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])])
                 (js/Promise.all #js [(.countDocuments c #js {:id "discord:g:c:m"}) (.countDocuments edges #js {:source_node_id "discord:g:c:m"})])))
        (.then (fn [n] (check! "base and five source edges persisted" [1 5] (js->clj n)) (js/Promise.all #js [(.countDocuments edges #js {:source_node_id "discord:g:c:m" :edge_kind "preceded_by" :target_node_id "discord:g:c:old"}) (.countDocuments edges #js {:source_node_id "discord:g:c:m" :edge_kind "mentions_topic" :target_node_id "topic:orbit"}) (.countDocuments edges #js {:source_node_id "discord:g:c:m" :edge_kind "has_attachment" :target_node_id "discord:attachment:a"})])))
        (.then (fn [n] (check! "three textless Discord projections persisted" [1 1 1] (js->clj n)) (wait-embeddings (.collection db "graph_node_embeddings") 4)))
        (.then (fn [n] (check! "synthetic embedding jobs persisted" 4 n) (check! "synthetic embedding generation invoked" true (pos? (count @embedding-calls))) (post [{:schema "openplanner.event.v1" :id "graph-edge-fixture" :ts "2026-01-01T03:00:00Z" :source "synthetic" :kind "graph.edge" :text "structural text" :source_ref {:project "lake"} :extra {:source_node_id " alpha " :target_node_id " beta " :edge_kind "links" :layer "custom" :detail "value"}}])))
        (.then (fn [r] (check! "graph.edge text response" [200 1 0 0 "skipped"] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])]) (.findOne edges #js {:source_node_id "alpha" :target_node_id "beta" :edge_kind "links"})))
        (.then (fn [e] (check! "graph.edge document fields" ["custom" "lake" "synthetic" "value"] [(.-layer e) (.-project e) (.-source e) (.. e -data -detail)])
                 (post [(event "discord:g:web:msg" "2026-01-01T00:10:00Z" {:guild_id "g" :channel_id "web" :urls ["https://bsky.app/profile/example.test/post/abc"]} "hello")])))
        (.then (fn [r] (println "TEXT-DISCORD" (pr-str r))
                 (check! "text Discord response" [200 6 1 4 "queued"] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])])
                 (-> (js/Promise. #(js/setTimeout %1 3000)) (.then (fn [] (js/Promise.all #js [(.countDocuments c #js {:id "graph.node:derive:discord:g:web:msg"}) (.countDocuments edges #js {:source_node_id "discord:g:web:msg" :edge_kind "mentions_bluesky_post"}) (.countDocuments (.collection db "event_chunks") #js {:parent_id "discord:g:web:msg"})]))))))
        (.then (fn [n] (check! "text Discord node edge and hot vector persist" [1 1 1] (js->clj n))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "false-fields" :ts "2026-01-01T00:11:00Z" :source "synthetic" :kind "graph.edge" :text false :attachments false :meta {:tags false} :extra {}}])))
        (.then (fn [r] (check! "false-field input accepted" 200 (:status r)) (.findOne c #js {:id "false-fields"})))
        (.then (fn [doc] (check! "nullish false fields preserved" ["false" false false] [(.-text doc) (.-attachments doc) (.-tags doc)])))
        (.then (fn [] (post [(event "prior-normalized" "2026-01-01T00:19:00Z" {:channel_id "lookup-x"} nil)])))
        (.then (fn [_] (post [{:schema "openplanner.event.v1" :id "review-cases" :ts "2026-01-01T00:20:00Z" :source "discord" :kind "discord.message" :text "hello" :source_ref {:project 123} :extra {:channel_id " lookup-x " :openplanner_labels {:quality "good" :labels [" alpha " "alpha"]}}}])))
        (.then (fn [r] (check! "review cases accepted" 200 (:status r)) (-> (js/Promise. #(js/setTimeout %1 3000)) (.then (fn [] (js/Promise.all #js [(.findOne edges #js {:source_node_id "review-cases" :edge_kind "preceded_by"}) (.findOne (.collection db "event_chunks") #js {:parent_id "review-cases"})]))))))
        (.then (fn [xs] (check! "predecessor channel normalized" "prior-normalized" (.. (aget xs 0) -data -previous_message_id))
                 (check! "vector metadata labels and quality" ["good" ["alpha"]] [(.-quality_label (aget xs 1)) (js->clj (.-labels (aget xs 1)))])
                 (check! "vector model scope normalizes project" true (boolean (some #(and (= "discord" (:source %)) (= "123" (:project %))) @model-scopes)))))
        (.then (fn [] (js/Promise.all #js [(.findOne c #js {:id "graph.node:discord:channel:lookup-x"}) (.findOne edges #js {:source_node_id "review-cases" :edge_kind "in_channel"}) (.findOne (.collection db "graph_label_nodes") #js {:label_id "label:default:alpha"})])))
        (.then (fn [xs] (check! "numeric project normalized in derived writes" ["123" "123" "123"] [(.-project (aget xs 0)) (.-project (aget xs 1)) (.-project (aget xs 2))])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "graph-node-case" :ts "2026-01-01T00:15:00Z" :source "synthetic" :kind "graph.node" :text "A careful little story." :source_ref {:project "lake"} :extra {:node_id "node:one" :openplanner_labels {:tenant_id "tenant" :labels ["Urgent" "urgent" "Urgent"]}}}])))
        (.then (fn [r] (println "GRAPH-NODE-LABEL" (pr-str r)) (check! "graph node and label response" [200 3 0 2 "queued"] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])])
                 (js/Promise.all #js [(.findOne (.collection db "graph_label_nodes") #js {:label_id "label:tenant:urgent"}) (.findOne edges #js {:source_node_id "graph-node-case" :edge_kind "has_label"}) (.countDocuments edges #js {:source_node_id "node:one" :edge_kind "contains_sentence"}) (.countDocuments c #js {:kind "graph.node" :extra.node_kind "sentence"})])))
        (.then (fn [xs] (check! "label first node and last merged edge" ["Urgent" "urgent" 1 1] [(.-label (aget xs 0)) (.. (aget xs 1) -data -label) (aget xs 2) (aget xs 3)])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "fail-label" :ts "2026-01-01T00:16:00Z" :source "synthetic" :kind "graph.node" :text "Four simple words today." :extra {:node_id "node:fail-label" :openplanner_labels {:labels ["Fail"]}}}])))
        (.then (fn [r] (check! "label bulk failure status" 500 (:status r)) (js/Promise.all #js [(.countDocuments c #js {:id "fail-label"}) (.countDocuments c #js {:kind "graph.node" :extra.derived_from_node_id "node:fail-label"}) (.countDocuments (.collection db "graph_label_nodes") #js {:label_id "label:default:fail"}) (.countDocuments edges #js {:source_node_id "fail-label"})])))
        (.then (fn [xs] (check! "label failure preserves base and derived node only" [1 1 0 0] (js->clj xs))))
        (.then (fn [] (post (mapv (fn [i] {:schema "openplanner.event.v1" :id (str "order-event-" i) :ts "2026-01-01T00:17:00Z" :source "synthetic" :kind "graph.node" :text (str "A careful little story number " i ".") :source_ref {:project (str "order-" i)} :extra {:node_id (str "node:order:" i)}}) (range 10)))))
        (.then (fn [r] (check! "ten graph nodes queue twenty embeddings" [200 20] [(:status r) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (-> (js/Promise. #(js/setTimeout %1 3000)) (.then (fn [] (-> (.find c #js {:extra.derived_from_node_id #js {:$regex "^node:order:"}}) (.sort #js {:$natural 1}) (.toArray)))))))
        (.then (fn [docs] (check! "ten derived nodes retain insertion order" (mapv #(str "node:order:" %) (range 10)) (mapv #(.. % -extra -derived_from_node_id) (vec docs)))
                 (check! "ten model groups retain insertion order" (mapv #(str "order-" %) (range 10)) (filterv #(and (string? %) (.startsWith % "order-")) @model-generation-order))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "chunk-case" :ts "2026-01-01T00:18:00Z" :source "synthetic" :kind "graph.node" :text (apply str (repeat 130 "A longer sentence contains several distinct words for a chunk. ")) :source_ref {:project "chunk-lake"} :extra {:node_id "node:chunk"}}])))
        (.then (fn [r] (println "CHUNK-CASE" (pr-str r)) (check! "chunk case accepted" 200 (:status r))
                 (js/Promise.all #js [(.countDocuments c #js {:kind "graph.node" :extra.parent_node_id "node:chunk"}) (.countDocuments edges #js {:source_node_id "node:chunk" :edge_kind "contains_chunk"}) (.countDocuments edges #js {:source_node_id "node:chunk" :edge_kind "contains_sentence"})])))
        (.then (fn [n] (println "CHUNK-PERSISTED" (pr-str (js->clj n))) (check! "chunk nodes and chunk edges agree" (aget n 0) (aget n 1)) (check! "chunk case produces multiple chunks" true (> (aget n 0) 1))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "note-raw" :ts "2026-01-01T00:21:00Z" :source "synthetic" :kind "note" :text "Ordinary note body." :extra {"a/b" {"x/y" 1 "y" 2} "b" 3 "nested" [{"z/w" false}]}}])))
        (.then (fn [r] (check! "generic note response" [200 0 1 1] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.findOne c #js {:id "note-raw"}) (.findOne c #js {:id "graph.node:derive:note-raw"})])))
        (.then (fn [xs] (let [expected {"a/b" {"x/y" 1 "y" 2} "b" 3 "nested" [{"z/w" false}]}
                              select #(select-keys (js->clj (.-extra %)) (keys expected))]
                          (check! "base nested metadata preserved" expected (select (aget xs 0)))
                          (check! "derived nested metadata preserved" expected (select (aget xs 1))))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "coercion-case" :ts "2026-01-01T00:22:00Z" :source "synthetic" :kind "graph.node" :text "hello" :extra {:node_id false :openplanner_labels {:labels [false {:a 1}]}}}])))
        (.then (fn [r] (check! "false node and labels response" [200 2 1] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.countDocuments (.collection db "graph_label_nodes") #js {:label_id "label:default:false"}) (.countDocuments (.collection db "graph_label_nodes") #js {:label_id "label:default:object-object"})])))
        (.then (fn [n] (check! "false and object labels persist" [1 1] (js->clj n))))
        (.then (fn [] (post [(event "attachment-cases" "2026-01-01T00:23:00Z" {:attachments [false nil {:id "present" :url 42}]} "hello")])))
        (.then (fn [r] (check! "false attachment entries ignored" 200 (:status r)) (.countDocuments c #js {:id "graph.node:discord:attachment:present"})))
        (.then (fn [n] (check! "present attachment id avoids fallback hash" 1 n)))
        (.then (fn [] (post [(event "attachment-nonarray" "2026-01-01T00:24:00Z" {:attachments false} "hello")])))
        (.then (fn [r] (check! "nonarray attachments ignored" 200 (:status r))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "discord:g:social:msg" :ts "2026-01-01T00:25:00Z" :source "discord" :kind "discord.message" :text "Hello <@123> and <@!456> in <#789>." :meta {:author_id "42" :author_username "alice" :author_global_name "Alice"} :extra {:guild_id "g" :channel_id "social" :mentions ["123" "123"] :mention_channels ["789"] :reply_to_message_id "prev"}}])))
        (.then (fn [r] (println "SOCIAL-CASE" (pr-str r)) (check! "Discord author mention and reply counters" [200 8 1 4] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.findOne c #js {:id "graph.node:discord:user:42"}) (.countDocuments edges #js {:source_node_id "discord:g:social:msg" :edge_kind "mentions_user"}) (.countDocuments edges #js {:source_node_id "discord:g:social:msg" :edge_kind "mentions_channel"}) (.findOne edges #js {:source_node_id "discord:g:social:msg" :edge_kind "replies_to"})])))
        (.then (fn [xs] (check! "Discord author mention and reply documents" ["Alice" 2 1 "discord:g:social:prev"] [(.-message (aget xs 0)) (aget xs 1) (aget xs 2) (.-target_node_id (aget xs 3))])))
        (.then (fn [] (post [(event "attachment-normalize" "2026-01-01T00:26:00Z" {:guild_id " g " :channel_id 7 :attachments [{:id "normalize"}]} "hello")])))
        (.then (fn [_] (.findOne c #js {:id "graph.node:discord:attachment:normalize"})))
        (.then (fn [doc] (check! "attachment guild and channel normalized" ["g" "7"] [(.. doc -extra -guild_id) (.. doc -extra -channel_id)])
                 (post [{:schema "openplanner.event.v1" :id "attachment-fallback" :ts "2026-01-01T00:27:00Z" :source "discord" :kind "discord.message" :text "hello" :source_ref {:session " fallback "} :extra {:guild_id nil :channel_id "" :attachments [{:id "fallback"}]}}])))
        (.then (fn [_] (.findOne c #js {:id "graph.node:discord:attachment:fallback"})))
        (.then (fn [doc] (check! "attachment null guild uses session and empty channel remains empty" ["fallback" ""] [(.. doc -extra -guild_id) (.. doc -extra -channel_id)])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "reaction-text" :ts "2026-01-01T00:28:00Z" :source "discord" :kind "discord.reaction" :text "reaction event" :extra {:user_id "u" :message_id "m" :emoji "👍" :guild_id "g" :channel_id "c"}}])))
        (.then (fn [r] (check! "reaction text response" [200 2 1 1] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.findOne c #js {:id "graph.node:discord:reaction:reaction-text"}) (.findOne edges #js {:source_node_id "discord:reaction:reaction-text" :edge_kind "reacted_to"}) (.findOne edges #js {:source_node_id "discord:user:u" :edge_kind "reacted_with"})])))
        (.then (fn [xs] (check! "reaction node and edges" ["Reaction 👍" "discord:g:c:m" "discord:reaction:reaction-text"] [(.-message (aget xs 0)) (.-target_node_id (aget xs 1)) (.-target_node_id (aget xs 2))])
                 (post [{:schema "openplanner.event.v1" :id "reaction-empty" :ts "2026-01-01T00:29:00Z" :source "discord" :kind "discord.reaction" :extra {:user_id "u" :message_id "m"}}])))
        (.then (fn [r] (check! "textless reaction stays unprojected" [200 0 0 0 "skipped"] [(:status r) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings]) (get-in r [:body :indexing])])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "generic-custom" :ts "2026-01-01T00:30:00Z" :source "synthetic" :kind "custom.record" :text "A generic indexable record." :meta {:author "author"} :extra {"key/one" {"value/two" 2}}}
                              {:schema "openplanner.event.v1" :id "generic-empty" :ts "2026-01-01T00:31:00Z" :source "synthetic" :kind "git.commit" :extra {:openplanner_labels {:labels ["Generic"]}}}])))
        (.then (fn [r] (check! "generic mixed-kind response" [200 2 1 1 1] [(:status r) (get-in r [:body :count]) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.findOne c #js {:id "graph.node:derive:generic-custom"}) (.countDocuments edges #js {:source_node_id "generic-empty" :edge_kind "has_label"})])))
        (.then (fn [xs] (check! "generic event derived node and label" ["custom.record" {"value/two" 2} 1] [(.. (aget xs 0) -extra -node_kind) (get (js->clj (.-extra (aget xs 0))) "key/one") (aget xs 1)])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "discord:combined:c:textless" :ts "2026-01-01T00:32:00Z" :source "discord" :kind "discord.message" :extra {:guild_id "combined" :channel_id "c" :previous_message_id "old" :topics ["Combined"] :attachments [{:id "combined-a"}]}}
                              {:schema "openplanner.event.v1" :id "combined-graph-node" :ts "2026-01-01T00:33:00Z" :source "synthetic" :kind "graph.node" :text "A careful little story." :extra {:node_id "combined-node" :openplanner_labels {:labels ["Combined"]}}}
                              {:schema "openplanner.event.v1" :id "combined-reaction" :ts "2026-01-01T00:34:00Z" :source "discord" :kind "discord.reaction" :text "react" :extra {:user_id "combined-u" :message_id "combined-m"}}
                              {:schema "openplanner.event.v1" :id "combined-generic" :ts "2026-01-01T00:35:00Z" :source "synthetic" :kind "custom.entry" :text "A plain generic record."}])))
        (.then (fn [r] (check! "combined batch response" [200 4 10 2 8] [(:status r) (get-in r [:body :count]) (get-in r [:body :projectedGraphEdges]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.countDocuments c #js {:id #js {:$in #js ["discord:combined:c:textless" "combined-graph-node" "combined-reaction" "combined-generic"]}}) (.countDocuments edges #js {:source_node_id "discord:combined:c:textless" :edge_kind "preceded_by"}) (.countDocuments edges #js {:source_node_id "discord:combined:c:textless" :edge_kind "mentions_topic"}) (.countDocuments edges #js {:source_node_id "discord:combined:c:textless" :edge_kind "has_attachment"})])))
        (.then (fn [n] (check! "combined base writes and textless projections" [4 1 1 1] (js->clj n))))
        (.then (fn [] (post [(event "coercion-discord" "2026-01-01T00:36:00Z" {:guild_id ["g" "x"] :channel_id ["c" "y"] :previous_message_id false :topics [{:a 1}] :urls [["https://example.invalid/a" "b"]]} "hello")])))
        (.then (fn [r] (check! "Discord object and array values accepted" 200 (:status r))
                 (js/Promise.all #js [(.countDocuments c #js {:id "graph.node:topic:object-object"}) (.countDocuments c #js {:id "graph.node:discord:guild:g,x"}) (.countDocuments c #js {:id "graph.node:discord:channel:c,y"}) (.countDocuments c #js {:id "graph.node:web:url:https://example.invalid/a,b"}) (.findOne edges #js {:source_node_id "coercion-discord" :edge_kind "preceded_by"})])))
        (.then (fn [xs] (check! "Discord object and array JS coercion" [1 1 1 1 "discord:g,x:c,y:false"] [(aget xs 0) (aget xs 1) (aget xs 2) (aget xs 3) (.-target_node_id (aget xs 4))])))
        (.then (fn [] (post [(event "attachment-bad-hash" "2026-01-01T00:37:00Z" {:attachments [{:url 42}]} "hello")])))
        (.then (fn [r] (println "ATTACHMENT-BAD-HASH" (pr-str r)) (check! "nonstring URL without ID fails" [500 "text.trim is not a function"] [(:status r) (get-in r [:body :message])])
                 (js/Promise.all #js [(.countDocuments c #js {:id "attachment-bad-hash"}) (.countDocuments c #js {:id "graph.node:derive:attachment-bad-hash"}) (.countDocuments edges #js {:source_node_id "attachment-bad-hash"})])))
        (.then (fn [n] (check! "bad attachment preserves only base" [1 0 0] (js->clj n))
                 (post [(event "attachment-js-fields" "2026-01-01T00:38:00Z" {:attachments [{:id "array-url" :url ["https://example.invalid/a" "b"] :filename "f" :content_type ["image" "png"] :size {:n 1}}]} "hello")])))
        (.then (fn [r] (check! "array/object attachment fields accepted" 200 (:status r))
