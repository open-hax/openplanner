                              {:schema "openplanner.event.v1" :id "scalar-string" :ts "2026-01-01T00:45:00Z" :source "synthetic" :kind "note" :text "Scalar string." :extra "xy" :meta "word"}
                              {:schema "openplanner.event.v1" :id "scalar-number" :ts "2026-01-01T00:46:00Z" :source "synthetic" :kind "note" :text "Scalar number." :extra 42 :meta 7}])))
        (.then (fn [r] (println "SCALAR-BATCH" (pr-str r)) (check! "scalar extra/meta batch response" [200 4 4 4] [(:status r) (get-in r [:body :count]) (get-in r [:body :queuedEventVectors]) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (js/Promise.all #js [(.findOne c #js {:id "scalar-false"}) (.findOne c #js {:id "scalar-array"}) (.findOne c #js {:id "scalar-string"}) (.findOne c #js {:id "scalar-number"}) (.findOne c #js {:id "graph.node:derive:scalar-array"}) (.findOne c #js {:id "graph.node:derive:scalar-string"})])))
        (.then (fn [xs] (let [field #(when % (js->clj (.-extra %))) spread #(when % (select-keys (js->clj (.-extra %)) ["0" "1"]))]
                          (check! "base extra false array string number retained" [false ["x" {"a/b" 1}] "xy" 42] (mapv field (take 4 (vec xs))))
                          (check! "derived array/string object-spread retained" [{"0" "x" "1" {"a/b" 1}} {"0" "x" "1" "y"}] [(spread (aget xs 4)) (spread (aget xs 5))]))))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "mixed-scalar" :ts "2026-01-01T00:47:00Z" :source "synthetic" :kind "note" :text "Prior scalar event." :extra "xy" :meta false} {:id "invalid"}])))
        (.then (fn [r] (check! "mixed scalar batch fails after admission" 500 (:status r)) (js/Promise.all #js [(.findOne c #js {:id "mixed-scalar"}) (.countDocuments c #js {:id "graph.node:derive:mixed-scalar"})])))
        (.then (fn [xs] (check! "mixed scalar base persists and queued node does not" ["xy" 0] [(.-extra (aget xs 0)) (aget xs 1)])))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "proto-note" :ts "2026-01-01T00:48:00Z" :source "synthetic" :kind "note" :text "Proto metadata." :extra {"__proto__" {"flag" true}}}])))
        (.then (fn [r] (check! "HTTP parser rejects own proto before route" 400 (:status r)) (.countDocuments c #js {:id "proto-note"})))
        (.then (fn [n] (check! "rejected proto request has no admission" 0 n)))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "proto-edge-a" :ts "2026-01-01T00:49:00Z" :source "synthetic" :kind "graph.edge" :extra {"source_node_id" "p||q" "target_node_id" "r" "edge_kind" "e" "__proto__" {"first" 1}}}
                              {:schema "openplanner.event.v1" :id "proto-edge-b" :ts "2026-01-01T00:50:00Z" :source "synthetic" :kind "graph.edge" :extra {"source_node_id" "p" "target_node_id" "q||r" "edge_kind" "e"}}])))
        (.then (fn [r] (check! "HTTP parser rejects proto collision batch" 400 (:status r)) (.countDocuments edges #js {:_id "p||q||r||e"})))
        (.then (fn [n] (check! "rejected proto collision has no edge" 0 n)))
        (.then (fn [] (post [{:schema "openplanner.event.v1" :id "mixed-edge" :ts "2026-01-01T00:12:00Z" :source "synthetic" :kind "graph.edge" :extra {:source_node_id "mx-a" :target_node_id "mx-b" :edge_kind "links"}} {:id "invalid"}])))
        (.then (fn [r] (check! "mixed graph.edge batch fails" 500 (:status r)) (js/Promise.all #js [(.countDocuments c #js {:id "mixed-edge"}) (.countDocuments edges #js {:source_node_id "mx-a"})])))
        (.then (fn [counts] (check! "mixed graph.edge retains base but skips derived edge" [1 0] (js->clj counts))))
        (.then (fn [] (post [ev])))
        (.then (fn [r] (check! "duplicate accepted" 200 (:status r)) (.countDocuments c #js {:id "discord:g:c:m"})))
        (.then (fn [n] (check! "duplicate base admissions preserved" 2 n) (post [(event "discord:g:c:reject" "2026-01-01T00:04:00Z" {:topics ["Reject"]} nil)])))
        (.then (fn [r] (check! "detached rejected embedding still returns queued" [200 1] [(:status r) (get-in r [:body :queuedGraphNodeEmbeddings])])
                 (-> (js/Promise. #(js/setTimeout %1 100)) (.then (fn [] (.countDocuments (.collection db "graph_node_embeddings") #js {:node_id "topic:reject"}))))))
        (.then (fn [n] (check! "rejected embedding writes no vector" 0 n) (post [(event "slow-slice" "2026-01-01T04:00:00Z" {:topics ["Slow"]} nil)])))
        (.then (fn [r] (check! "HTTP returns before embedding promise resolves" 200 (:status r)) (wait-slow 100)))
        (.then (fn [started] (check! "controlled embedding promise started" true started)
                 (@slow-reject (js/Error. "controlled embedding rejection"))
                 (-> (js/Promise. #(js/setTimeout %1 100)) (.then (fn [] (.countDocuments (.collection db "graph_node_embeddings") #js {:node_id "topic:slow"}))))))
        (.then (fn [n] (check! "rejected detached embedding not stored" 0 n) (post [(assoc ev :id "discord:g:c:partial") {:id "invalid"}])))
        (.then (fn [r] (check! "mixed batch failure" [500 "event.schema must be openplanner.event.v1"] [(:status r) (get-in r [:body :message])]) (.countDocuments c #js {:id "discord:g:c:partial"})))
        (.then (fn [n] (check! "mixed batch partial admission" 1 n)
                 (post [(event "fail-node" "2026-01-01T02:00:00Z" {:guild_id "g" :channel_id "f" :topics ["Failure"]} "hello")])))
        (.then (fn [r] (check! "node failure status" 500 (:status r)) (js/Promise.all #js [(.countDocuments c #js {:id "fail-node"}) (.countDocuments c #js {:id "graph.node:topic:failure"}) (.countDocuments edges #js {:source_node_id "fail-node"})])))
        (.then (fn [n] (check! "node failure partial writes" [1 0 0] (js->clj n)) (post [(event "fail-edge" "2026-01-01T02:01:00Z" {:guild_id "g" :channel_id "f" :topics ["FailureEdge"]} "hello")])))
        (.then (fn [r] (check! "edge failure status" 500 (:status r)) (js/Promise.all #js [(.countDocuments c #js {:id "fail-edge"}) (.countDocuments c #js {:id "graph.node:topic:failureedge"}) (.countDocuments edges #js {:source_node_id "fail-edge"})])))
        (.then (fn [n] (check! "edge failure partial writes" [1 1 0] (js->clj n)) (post [(event "fail-kafka" "2026-01-01T02:02:00Z" {:guild_id "g" :channel_id "f" :topics ["Kafka"]} "hello")])))
        (.then (fn [r] (check! "awaited kafka failure status" 500 (:status r)) (js/Promise.all #js [(.countDocuments c #js {:id "fail-kafka"}) (.countDocuments c #js {:id "graph.node:topic:kafka"}) (.countDocuments edges #js {:source_node_id "fail-kafka"})])))
        (.then (fn [n] (check! "kafka failure follows writes" true (and (= 1 (aget n 0)) (= 1 (aget n 1)) (pos? (aget n 2)))))))))

(defn compose-app [modules cfg]
  (let [fastify (.-default (aget modules 3)) app (fastify #js {:logger true :bodyLimit (* 50 1024 1024) :pluginTimeout 120000})
        targets (atom #{})]
    (aset app "openplannerConfig" cfg)
    (aset app "embeddingRuntime" #js {:hot #js {:getModel (fn [scope] (swap! model-scopes conj (js->clj scope :keywordize-keys true)) (let [p (.-project scope)] (if (and (string? p) (.startsWith p "order-")) p "synthetic-model")))
                                                  :getBackgroundEmbeddingFunction (fn [_] #js {:generate (fn [texts] (synthetic-embedding texts))})
                                                  :getBackgroundEmbeddingFunctionForModel (fn [model] #js {:generate (fn [texts] (swap! model-generation-order conj model) (swap! embedding-calls conj (js->clj texts)) (if (some #(= "Topic: Reject" %) (vec texts)) (js/Promise.reject (js/Error. "synthetic embedding failure")) (synthetic-embedding texts)))})}})
    (.addHook app "onRoute" (fn [route]
                              (when (and (= "POST" (.-method route))
                                         (contains? #{"/v1/graph/connections" "/v1/events"} (.-url route)))
                                (swap! targets conj (.-url route))
                                (when (= "/v1/events" (.-url route))
                                  (set! (.-handler route)
                                        (fn [req reply]
                                          (let [app (.-server req) id (some-> req .-body .-events (aget 0) .-id)
                                                target (case id "fail-node" (.. app -mongo -events) "fail-edge" (.. app -mongo -graphEdges) "fail-label" (.. app -mongo -graphLabelNodes) nil)
                                                old (when target (.-bulkWrite target)) kafka (when (= id "fail-kafka") (.-kafkaEvents app)) old-kafka (when kafka (.-publishRawEvents kafka))]
                                            (when target (set! (.-bulkWrite target) (fn [& _] (js/Promise.reject (js/Error. "injected bulk failure")))))
                                            (when kafka (set! (.-publishRawEvents kafka) (fn [& _] (js/Promise.reject (js/Error. "injected kafka failure")))))
                                            (-> (js/Promise.resolve (slice/handler app (.-eventAdmission ((.-createProtocols (aget modules 12)) app)) (.-counterInc (aget modules 13)) (.-indexTextInMongoVectors (aget modules 14)) (.-prepareIndexDocument (aget modules 15)) (.-splitSentences (aget modules 16)) (fn [task] (swap! background-tasks conj task)) req reply))
                                                (.finally (fn [] (when target (set! (.-bulkWrite target) old)) (when kafka (set! (.-publishRawEvents kafka) old-kafka))))))))))))

    (-> (.register app (.-default (aget modules 5)))
        (.then #(.register app (.-default (aget modules 6)) #js {:limits #js {:fileSize (* 200 1024 1024)}}))
        (.then #(.register app (.-authPlugin (aget modules 7)) cfg))
        (.then #(.register app (.-mongodbPlugin (aget modules 8)) cfg))
        (.then #(.register app (.-tenantPlugin (aget modules 9)) #js {:strict false}))
        (.then #(.register app (.-kafkaEventsPlugin (aget modules 10))))
        (.then #(.register app (.-v1Routes (aget modules 11)) #js {:prefix "/v1"}))
        (.then (fn []
                 (.get app "/" (fn [_req _reply] #js {:ok true :name "openplanner" :version "0.3.0" :storageBackend "mongodb"}))
                 (check! "onRoute saw target registrations" #{"/v1/graph/connections" "/v1/events"} @targets)
                 app)))))

(defn run-app [modules]
  (let [client (new (.-MongoClient (aget modules 2)) (str uri "/?directConnection=true"))
        db (.db client db-name)
        app-ref (atom nil)]
    (-> (.connect client)
        (.then (fn [] (compose-app modules ((.-loadConfig (aget modules 1))))) )
        (.then (fn [app] (reset! app-ref app) (.listen app #js {:host "127.0.0.1" :port 0})))
        (.then (fn [base] (run-cases base db)))
        (.then (fn [] (-> (js/Promise.allSettled (to-array @background-tasks)) (.then (fn [results] (check! "all tracked background tasks settled before cleanup" (count @background-tasks) (.-length results)))))))
        (.finally (fn [] (-> (if @app-ref (.close @app-ref) (js/Promise.resolve))
                             (.then #(.dropDatabase db))
                             (.then (fn [dropped] (println "Database dropped:" db-name dropped) (.close client)))))))))

(if-not (and uri (re-matches #"mongodb://127\.0\.0\.1:[0-9]+/?" uri))
  (do (js/console.error "OPENPLANNER_E2E_MONGO_URI must name disposable loopback MongoDB") (set! (.-exitCode js/process) 2))
  (do
    (set! (.-MONGODB_URI js/process.env) (str uri "/?directConnection=true"))
    (set! (.-MONGODB_DB js/process.env) db-name)
    (set! (.-OPENPLANNER_API_KEY js/process.env) "isolated-test-key")
    (set! (.-OPENPLANNER_KAFKA_ENABLED js/process.env) "false")
    (set! (.-OPENPLANNER_KAFKA_PUBLISH_MODE js/process.env) "await")
    (set! (.-OPENPLANNER_DATA_DIR js/process.env) (str "/tmp/" db-name))
    (set! (.-EMBED_PROVIDER_BASE_URL js/process.env) "http://127.0.0.1:1")
    (-> (js/Promise.all #js [(js/import "../../src/app.ts") (js/import "../../src/lib/config.ts") (js/import "mongodb")
                              (js/import "fastify") (js/import "../../src/lib/embedding-runtime.ts")
                              (js/import "@fastify/sensible") (js/import "@fastify/multipart")
                              (js/import "../../src/plugins/auth.ts") (js/import "../../src/plugins/mongodb.ts")
                              (js/import "../../src/plugins/tenant.ts") (js/import "../../src/plugins/kafka-events.ts")
                              (js/import "../../src/routes/v1/index.ts") (js/import "../../src/lib/protocol-adapters.ts") (js/import "../../src/lib/metrics.ts") (js/import "../../src/lib/mongo-vectors.ts") (js/import "../../src/lib/indexing.ts") (js/import "../../src/lib/sentence-split.ts")])
        (.then run-app)
        (.then (fn [] (when (pos? @failures) (set! (.-exitCode js/process) 1))))
        (.catch (fn [err] (js/console.error err) (set! (.-exitCode js/process) 2))))))
