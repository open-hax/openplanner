;; Lifecycle probe only: unchanged buildApp, disposable MongoDB, loopback HTTP.
(ns graph-connections-seam-probe)
(def uri (.-OPENPLANNER_E2E_MONGO_URI js/process.env))
(def db-name (str "openplanner5_probe_" (.replaceAll (str (random-uuid)) "-" "")))
(defn request [base auth? path]
  (-> (js/fetch (str base path) (clj->js {:method "POST" :headers (cond-> {"content-type" "application/json"} auth? (assoc "authorization" "Bearer isolated-test-key")) :body "{}"}))
      (.then (fn [r] {:status (.-status r)}))))
(defn run-probe [modules]
  (let [client (new (.-MongoClient (aget modules 2)) uri) db (.db client db-name) app-ref (atom nil) calls (atom [])]
    (-> (.connect client)
        (.then (fn [] ((.-buildApp (aget modules 0)) ((.-loadConfig (aget modules 1))))))
        (.then (fn [app]
                 (reset! app-ref app)
                 (try (.addHook app "onRequest" (fn [_req _reply done] (swap! calls conj :request) (done)))
                      (println "post-build hook registration: accepted")
                      (catch :default e (println "post-build hook registration:" (.-code e) (.-message e))))
                 (try (.addHook app "preHandler" (fn [req _reply done] (swap! calls conj [:pre-handler (.-url req)]) (done)))
                      (println "post-build preHandler registration: accepted")
                      (catch :default e (println "post-build preHandler registration:" (.-code e) (.-message e))))
                 (try (.addHook app "onSend" (fn [req reply payload done] (swap! calls conj [:on-send (.-url req) (.-statusCode reply)]) (done nil payload)))
                      (println "post-build onSend registration: accepted")
                      (catch :default e (println "post-build onSend registration:" (.-code e) (.-message e))))
                 (try (.post app "/v1/graph/connections" (fn [_req reply] (.send reply #js {:probe true})))
                      (println "duplicate route registration: accepted")
                      (catch :default e (println "duplicate route registration:" (.-code e) (.-message e))))
                 (.listen app #js {:host "127.0.0.1" :port 0})))
        (.then (fn [base]
                 (-> (request base false "/v1/graph/connections")
                     (.then (fn [r] (println "unauthorized status:" (:status r) "probe hooks:" (count @calls)) (request base true "/v1/graph/connections")))
                     (.then (fn [r] (println "authorized status:" (:status r) "probe hooks:" (pr-str @calls)) (request base true "/v1/events")))
                     (.then (fn [r] (println "invalid event status:" (:status r) "probe hooks:" (pr-str @calls)))))))
        (.finally (fn [] (-> (if @app-ref (.close @app-ref) (js/Promise.resolve))
                             (.then #(.dropDatabase db))
                             (.then (fn [dropped] (println "Database dropped:" db-name dropped) (.close client)))))))))
(if-not (and uri (re-matches #"mongodb://127\.0\.0\.1:[0-9]+/?" uri))
  (do (js/console.error "OPENPLANNER_E2E_MONGO_URI must name disposable loopback MongoDB") (set! (.-exitCode js/process) 2))
  (do
    (set! (.-MONGODB_URI js/process.env) uri)
    (set! (.-MONGODB_DB js/process.env) db-name)
    (set! (.-OPENPLANNER_API_KEY js/process.env) "isolated-test-key")
    (set! (.-OPENPLANNER_KAFKA_ENABLED js/process.env) "false")
    (set! (.-OPENPLANNER_DATA_DIR js/process.env) (str "/tmp/" db-name))
    (set! (.-EMBED_PROVIDER_BASE_URL js/process.env) "http://127.0.0.1:1")
    (-> (js/Promise.all #js [(js/import "../src/app.ts") (js/import "../src/lib/config.ts") (js/import "mongodb")])
        (.then run-probe)
        (.catch (fn [err] (js/console.error err) (set! (.-exitCode js/process) 2))))))
